    h2 { font-size: 15pt; margin-top: 28px; }
    p { text-align: justify; margin: 8px 0; }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 12px 0 18px;
    }
    th, td {
      border: 1px solid #333;
      padding: 8px;
      vertical-align: top;
    }
    th {
      background: #efefef;
      text-align: center;
    }
